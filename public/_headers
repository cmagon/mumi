# Cloudflare Pages / Workers Assets — no cachear el shell ni el id de build.
# Los assets con hash en /assets/ pueden cachearse agresivamente (lo define el hosting).

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/build-id.txt
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
